{
  "name": "@specquer/documentation",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@astrojs/starlight": "^0.42.5",
    "@types/bun": "latest",
    "astro": "^7.3.5",
    "starlight-theme-exquisitus": "^1.2.0"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "scripts": {
    "docs:dev": "bun --bun astro dev",
    "docs:build": "bun --bun astro build",
