{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    // Solid compiles JSX itself (via vite-plugin-solid), so TypeScript only type-checks it
    "jsx": "preserve",
    "jsxImportSource": "solid-js"
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
