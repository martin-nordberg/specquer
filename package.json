{
  "name": "specquer",
  "type": "module",
  "private": true,
  "workspaces": [
    "server",
    "agent",
    "client",
    "shared",
    "documentation"
  ],
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "scripts": {
    "dev": "bun run --filter @specquer/server dev",
    "build": "bun run --filter @specquer/server build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p client && tsc --noEmit -p client/tsconfig.test.json",
    "test": "bun test",
    "test:e2e": "bun --bun x playwright test"
  }
}
